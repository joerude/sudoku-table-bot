# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Path to the SQLite database file (inside the container this is a mounted volume)
DB_PATH=/data/sudoku.db

# Optional: Telegram user id of the bot owner. The owner can /backup and /restore
# from any chat, including a private one. Without it only group admins can, and
# only inside a group. Get your id from a bot like @userinfobot.
OWNER_TG_ID=
